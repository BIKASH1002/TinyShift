# Copy to backend/.env for local development.
# These two values are public browser configuration, not private credentials.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# Optional: public VAPID key matching WEB_PUSH_PUBLIC_KEY in Edge Function secrets.
EXPO_PUBLIC_WEB_PUSH_KEY=

# Configure GEMINI_API_KEY and GEMINI_MODEL in Supabase Edge Function secrets.

